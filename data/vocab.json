  {"id":"v-0033","word":"relinquish","pos":"verb","meaning":"手放す、譲り渡す","synonyms":["surrender","hand over"],"example":"The founder agreed to relinquish control of the company to the new board.","distractors":["incur","elicit","scrutinize"]},
