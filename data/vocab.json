  {"id":"v-0012","word":"scrutinize","pos":"verb","meaning":"精査する、細かく調べる","synonyms":["examine","inspect"],"example":"Auditors will scrutinize every transaction from the past fiscal year.","distractors":["commend","vacate","waive"]},
  {"id":"v-0013","word":"stipulate","pos":"verb","meaning":"（契約などで）規定する、明記する","synonyms":["specify","state"],"example":"The contract does not stipulate a deadline for delivery.","distractors":["convene","vacate","commend"]},
