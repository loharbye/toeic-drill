  {"id":"v-0025","word":"enumerate","pos":"verb","meaning":"列挙する、一つ一つ挙げる","synonyms":["list","itemize"],"example":"The report will enumerate the risks associated with the merger.","distractors":["vacate","convene","reimburse"]},
