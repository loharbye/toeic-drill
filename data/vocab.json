  {"id":"v-0036","word":"substantiate","pos":"verb","meaning":"立証する、裏付ける","synonyms":["prove","verify"],"example":"Please provide receipts to substantiate your expense claims.","distractors":["convene","vacate","elicit"]},
  {"id":"v-0037","word":"terminate","pos":"verb","meaning":"（契約などを）終了させる、解除する","synonyms":["end","discontinue"],"example":"Either party may terminate the agreement with 30 days' notice.","distractors":["commend","elicit","replenish"]},
  {"id":"v-0038","word":"underscore","pos":"verb","meaning":"強調する、浮き彫りにする","synonyms":["emphasize","highlight"],"example":"The incident served to underscore the importance of regular maintenance.","distractors":["vacate","reimburse","convene"]},
  {"id":"v-0039","word":"vacate","pos":"verb","meaning":"（場所を）明け渡す、立ち退く","synonyms":["leave","move out of"],"example":"Tenants must vacate the premises by the end of the month.","distractors":["commend","elicit","ratify"]},
  {"id":"v-0040","word":"retain","pos":"verb","meaning":"保持する、引き留める","synonyms":["keep","preserve"],"example":"The company is working hard to retain its most talented employees.","distractors":["incur","waive","enumerate"]},
