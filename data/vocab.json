  {"id":"v-0017","word":"adhere","pos":"verb","meaning":"（規則などを）守る、固守する","synonyms":["follow","comply"],"example":"All staff must adhere to the safety protocols.","distractors":["vacate","elicit","procure"]},
  {"id":"v-0018","word":"allocate","pos":"verb","meaning":"割り当てる、配分する","synonyms":["distribute","allot"],"example":"The committee will allocate funds to each department next month.","distractors":["elicit","vacate","commend"]},
