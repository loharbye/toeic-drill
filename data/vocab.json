[
  {"id":"v-0001","word":"expedite","pos":"verb","meaning":"迅速に処理する、早める","synonyms":["accelerate","speed up"],"example":"We will expedite the shipment of your order.","distractors":["commend","elicit","enumerate"],"related":["facilitate"]},
  {"id":"v-0002","word":"alleviate","pos":"verb","meaning":"（苦痛・問題を）軽減する","synonyms":["ease","relieve"],"example":"The new parking garage should alleviate congestion around the office.","distractors":["commend","ratify","vacate"],"related":["mitigate","curtail"]},
  {"id":"v-0003","word":"augment","pos":"verb","meaning":"増大させる、補強する","synonyms":["increase","supplement"],"example":"The company hired contractors to augment its existing workforce.","distractors":["rectify","elicit","enumerate"]},
