  {"id":"v-0027","word":"implement","pos":"verb","meaning":"実行する、実施する","synonyms":["carry out","execute"],"example":"The city plans to implement the new recycling program in April.","distractors":["vacate","deem","elicit"]},
  {"id":"v-0028","word":"incur","pos":"verb","meaning":"（費用・損失を）負う、被る","synonyms":["run up","sustain"],"example":"Travelers who incur additional costs should keep their receipts.","distractors":["convene","commend","vacate"]},
