  {"id":"v-0048","word":"tentative","pos":"adjective","meaning":"仮の、暫定的な","synonyms":["provisional","preliminary"],"example":"We have set a tentative date of May 12 for the conference.","distractors":["lucrative","lenient","stringent"],"related":["provisional","provisionally"]},
