  {"id":"v-0005","word":"delegate","pos":"verb","meaning":"（権限・仕事を）委任する","synonyms":["entrust","assign"],"example":"Effective managers know how to delegate routine tasks to their staff.","distractors":["elicit","forfeit","ratify"],"related":["allocate","relinquish"]},
  {"id":"v-0006","word":"endorse","pos":"verb","meaning":"支持する、是認する","synonyms":["support","back"],"example":"The board voted to endorse the proposed budget.","distractors":["vacate","elicit","incur"],"related":["ratify"]},
  {"id":"v-0007","word":"facilitate","pos":"verb","meaning":"容易にする、円滑にする","synonyms":["help","enable"],"example":"The new software will facilitate communication between departments.","distractors":["vacate","forfeit","reimburse"],"related":["expedite","streamline"]},
  {"id":"v-0008","word":"mitigate","pos":"verb","meaning":"和らげる、緩和する","synonyms":["reduce","lessen"],"example":"Insurance can help mitigate the financial risks of the project.","distractors":["commend","vacate","convene"],"related":["curtail"]},
  {"id":"v-0009","word":"procure","pos":"verb","meaning":"調達する、入手する","synonyms":["obtain","acquire"],"example":"The purchasing department must procure office supplies at the lowest possible cost.","distractors":["commend","convene","underscore"]},
